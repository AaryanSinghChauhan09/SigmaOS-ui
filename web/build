#!/bin/bash

# Build the Electron / web binding (tools/bindings.d/web.json). It is plain ES modules with no
# runtime dependencies, so "building" is checking: every module parses, the preload's copy of
# createOmarchy matches src/api.js, the gallery lists its sections, and the core's CLI is there
# for the gallery and the Electron main process to spawn.

set -euo pipefail

WEB="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$WEB/.." && pwd)"

command -v node >/dev/null || { echo "web: no node" >&2; exit 1; }
[[ -x $ROOT/target/release/omarchy-theme || -n ${OMARCHY_THEME_BIN:-} ]] || command -v omarchy-theme >/dev/null ||
  { echo "web: no omarchy-theme CLI (bin/build core)" >&2; exit 1; }

while IFS= read -r -d '' f; do
  node --check "$f"
done < <(find "$WEB" \( -path "$WEB/node_modules" -o -path "$WEB/tauri/target" \) -prune -o \( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \) -print0)
node --check "$WEB/bin/omarchy-web-gallery"
node --check "$WEB/bin/omarchy-web-css"
node "$WEB/tools/sync-preload.mjs" --check >/dev/null
# src/restyle.css, for a <link>, from src/restyle.js (the one source).
node --input-type=module -e "import { restyleCss } from '$WEB/src/restyle.js'; process.stdout.write('/* Generated from src/restyle.js by web/build. */\n' + restyleCss)" >"$WEB/src/restyle.css"
# src/elements/index.d.ts, the elements' TypeScript declarations, from their sources.
node "$WEB/tools/gen-types.mjs" >/dev/null
[[ $("$WEB/bin/omarchy-web-gallery" --list-sections | wc -l) -gt 0 ]]
echo "web/bin/omarchy-web-gallery"
