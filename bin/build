#!/bin/bash

# Build the core (the omarchy-theme CLI and the C library) and every binding in the registry
# (tools/bindings.d/*.json) into build/ and target/. A binding whose toolchain is missing is
# skipped with a message.
#
#   bin/build              # the core, then every available binding
#   bin/build core         # just the omarchy-theme CLI and the C library (build/ffi)
#   bin/build qt rune      # just these bindings (by registry name)

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

core() {
  # The resolver for everything that isn't Rust: the CLI, and the C library staged as a package
  # lays it out (lib, include, pkgconfig), so PKG_CONFIG_PATH=build/ffi/lib/pkgconfig finds it.
  # And omarchy-ansi, which bin/review renders and diffs the terminal bindings' snapshots with.
  cargo build -q --release --manifest-path "$ROOT/Cargo.toml" -p omarchy-theme -p omarchy-theme-ffi -p omarchy-ansi
  rm -rf "$ROOT/build/ffi"
  "$ROOT/crates/omarchy-theme-ffi/stage" "$ROOT/target/release/libomarchy_theme_ffi.so" "" "$ROOT/build/ffi"
  echo "target/release/omarchy-theme"
  echo "build/ffi/lib/libomarchy-theme.so"
  echo "target/release/omarchy-ansi"
}

if (( $# == 0 )); then
  core
  python3 "$ROOT/tools/bindings.py" build
  exit
fi

bindings=()
for what in "$@"; do
  if [[ $what == "core" ]]; then
    core
  else
    bindings+=("$what")
  fi
done
if (( ${#bindings[@]} )); then
  python3 "$ROOT/tools/bindings.py" build "${bindings[@]}"
fi
