#!/bin/bash

# Build both galleries (and the token CLI and the Qt tests) into build/.
#
#   bin/build          # everything
#   bin/build qt       # just the Qt gallery, its tests and the installable QML module
#   bin/build rune     # just the Rune gallery and omarchy-theme
#   bin/build core     # the omarchy-theme CLI and the C library (build/ffi)

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
what="${1:-all}"

if [[ $what == "all" || $what == "qt" ]]; then
  mkdir -p "$ROOT/build/qt"
  (cd "$ROOT/build/qt" && qmake6 "$ROOT/qt/gallery/gallery.pro" >/dev/null && make -s -j"$(nproc)" 2>&1 | grep -v "^make" || true)
  [[ -x $ROOT/build/qt/omarchy-qt-gallery ]] || { echo "Qt gallery failed to build" >&2; exit 1; }
  echo "build/qt/omarchy-qt-gallery"
  mkdir -p "$ROOT/build/qt-tests"
  (cd "$ROOT/build/qt-tests" && qmake6 "$ROOT/qt/tests/tests.pro" >/dev/null && make -s -j"$(nproc)" 2>&1 | grep -v "^make" || true)
  [[ -x $ROOT/build/qt-tests/omarchy-qt-tests ]] || { echo "Qt tests failed to build" >&2; exit 1; }
  echo "build/qt-tests/omarchy-qt-tests"
  # The installed-module route (qt/module): `make -C build/qt-module install INSTALL_ROOT=...`.
  mkdir -p "$ROOT/build/qt-module"
  (cd "$ROOT/build/qt-module" && qmake6 "$ROOT/qt/module/module.pro" >/dev/null && make -s -j"$(nproc)" 2>&1 | grep -v "^make" || true)
  [[ -f $ROOT/build/qt-module/libomarchyuiplugin.so ]] || { echo "Qt module failed to build" >&2; exit 1; }
  echo "build/qt-module/libomarchyuiplugin.so"
fi

if [[ $what == "all" || $what == "core" ]]; then
  # The resolver for everything that isn't Rust: the CLI, and the C library staged as a package
  # lays it out (lib, include, pkgconfig), so PKG_CONFIG_PATH=build/ffi/lib/pkgconfig finds it.
  cargo build -q --release --manifest-path "$ROOT/Cargo.toml" -p omarchy-theme -p omarchy-theme-ffi
  rm -rf "$ROOT/build/ffi"
  "$ROOT/crates/omarchy-theme-ffi/stage" "$ROOT/target/release/libomarchy_theme_ffi.so" "" "$ROOT/build/ffi"
  echo "target/release/omarchy-theme"
  echo "build/ffi/lib/libomarchy-theme.so"
fi

if [[ $what == "all" || $what == "rune" ]]; then
  cargo build -q --release --manifest-path "$ROOT/Cargo.toml" -p omarchy-rune-gallery -p omarchy-theme
  echo "target/release/omarchy-rune-gallery"
  echo "target/release/omarchy-theme"
fi
