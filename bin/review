#!/bin/bash

# Compare the frameworks: build every binding in the registry (tools/bindings.d), check that each
# one resolving tokens itself matches the core for every fixture theme, render every gallery
# section in each for a set of themes and roundings, diff each against the reference (Qt), and
# write out/review/index.html (side by side in N columns, overlay, swipe and pixel diff).
#
#   bin/review                         default themes (live + five fixtures), radius 0 and 8
#   bin/review --all-themes            every fixture
#   bin/review --themes nord,white --radii 0 --sections buttons,inputs
#   bin/review --bindings rune         only these beside the reference
#   bin/review --open                  ...and open the page
#   bin/review --live                  skip the report; open every gallery as a window instead
#
# Keys on the page: t theme, r radius, s section, v view, a against (shift goes back).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  sed -n '3,16p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

if [[ ${1:-} == "--live" ]]; then
  "$ROOT/bin/build" >/dev/null
  # Every gallery follows the desktop theme: switch themes (or rounding) and watch them change
  # together.
  exec python3 "$ROOT/tools/bindings.py" windows
fi

open=0
args=()
only=""
prev=""
for arg in "$@"; do
  if [[ $arg == "--open" ]]; then
    open=1
  else
    args+=("$arg")
  fi
  if [[ $prev == "--bindings" ]]; then
    only="$arg"
  elif [[ $arg == --bindings=* ]]; then
    only="${arg#--bindings=}"
  fi
  prev="$arg"
done

# With --bindings, build only the reference and those, so a half-built binding elsewhere in the
# registry doesn't stop the review.
if [[ -n $only ]]; then
  reference="$(python3 "$ROOT/tools/bindings.py" list 2>/dev/null | head -n1)"
  "$ROOT/bin/build" core ${reference:+"$reference"} ${only//,/ } >/dev/null
else
  "$ROOT/bin/build" >/dev/null
fi
python3 "$ROOT/tools/review.py" "${args[@]}"

if (( open )); then
  xdg-open "$ROOT/out/review/index.html" >/dev/null 2>&1 &
fi
