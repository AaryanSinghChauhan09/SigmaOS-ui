#!/bin/bash

# Copy the Omarchy shell's portable QML kit into qt/qml/Omarchy, rewriting only imports, so the
# Qt binding stays the shell's own code and can be re-pulled whenever quattro moves.
#
#   bin/harvest-qt            # copy from $OMARCHY_SRC (default ~/omarchy) and record its rev
#   bin/harvest-qt --check    # list upstream changes since the recorded rev, including to the
#                             # hand-ported files, without copying anything
#
# Color.qml, Style.qml, Util.qml and I18n.qml are hand-ported (their file watching, hyprctl calls
# and Quickshell process helpers are replaced by the C++ ThemeSource), so they are never
# overwritten here; --check shows what changed upstream so the port can follow.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OMARCHY_SRC="${OMARCHY_SRC:-$HOME/omarchy}"
UI_OUT="$ROOT/qt/qml/Omarchy/Ui"
THEME_OUT="$ROOT/qt/qml/Omarchy/Theme"
REV_FILE="$ROOT/qt/HARVEST_REV"

# Components that only need the shell's tokens. Anything that opens a layer-shell window or runs
# Quickshell processes (PopupCard, Panel, KeyboardPanel, bar widgets) stays behind. MultiSelect
# comes along because a patch (0002) drops its command-backed options.
UI_FILES=(
  BorderOverlay BorderSurface Button ButtonGroup ConfirmDialog CursorSurface Dropdown
  FilterInput IconContentBounds MultiSelect NumberField OpticalGlyph PanelActionButton PanelHero
  PanelKeyCatcher PanelSectionHeader PanelSeparator PanelSlider PanelToolTip PointerMoveGate
  PopupMenuRow SearchableDropdown
  SizedImage TextField Toggle ToggleSwitch
)
# Whole key families to carry even where no harvested file names them, so an app driving a
# component's states itself (MultiSelect's options errors) can show the shell's wording.
EXTRA_KEY_PREFIXES=(multiSelect.)
THEME_FILES=(Border.qml BorderGeometry.js Numbers.js)
PORTED_FILES=(Color.qml Style.qml Util.qml I18n.qml)

if [[ ${1:-} == "--check" ]]; then
  rev="$(cat "$REV_FILE")"
  paths=()
  for f in "${UI_FILES[@]}"; do paths+=("shell/Ui/$f.qml"); done
  for f in "${THEME_FILES[@]}" "${PORTED_FILES[@]}"; do paths+=("shell/Commons/$f"); done
  echo "Upstream changes since $rev:"
  git -C "$OMARCHY_SRC" diff --stat "$rev"..HEAD -- "${paths[@]}"
  exit 0
fi

rewrite() {
  sed \
    -e 's|^import qs\.Commons as Commons$|import Omarchy.Theme as Commons|' \
    -e 's|^import qs\.Commons$|import Omarchy.Theme|' \
    -e '/^import qs\.Ui$/d' \
    -e 's|^import "\.\./Commons/BorderGeometry\.js" as Geometry$|import "../Theme/BorderGeometry.js" as Geometry|' \
    -e 's|qs\.Commons|Omarchy.Theme|g' \
    -e 's|qs\.Ui|Omarchy.Ui|g' \
    "$1"
}

mkdir -p "$UI_OUT" "$THEME_OUT"
for f in "${UI_FILES[@]}"; do
  rewrite "$OMARCHY_SRC/shell/Ui/$f.qml" >"$UI_OUT/$f.qml"
done
for f in "${THEME_FILES[@]}"; do
  rewrite "$OMARCHY_SRC/shell/Commons/$f" >"$THEME_OUT/$f"
done

# Local fixes the shell doesn't need (it runs under the desktop's platform style), kept as patches
# so each divergence from upstream stays visible and can be sent upstream.
for patch in "$ROOT"/qt/patches/*.patch; do
  [[ -f $patch ]] || continue
  patch -s -p1 -d "$ROOT" <"$patch" || { echo "patch no longer applies: $patch" >&2; exit 1; }
  echo "applied $(basename "$patch")"
done

if grep -rnE '^import (Quickshell|qs\.)|Quickshell\.' "$UI_OUT" "$THEME_OUT" --include='*.qml' --include='*.js'; then
  echo "harvested files still reference Quickshell; port or drop them" >&2
  exit 1
fi

# The few strings the components show (Cancel, Search...), in every Omarchy language, plus each
# language's direction and number format, so the kit follows `omarchy language` like the shell.
# The keys are every I18n.t call in Ui/, harvested and kit-owned alike (SearchList's
# common.noMatchesFor comes from there). The Rune binding reads the same file
# (crates/omarchy-theme/src/strings.rs parses the `var catalog = ` line), so keep it one line.
keys="$(grep -rhoE 'I18n\.tn?\("[^"]+"' "$UI_OUT" | sed -E 's/.*\("//; s/"$//' | sort -u)"
python3 - "$OMARCHY_SRC/default/i18n" "$THEME_OUT/Strings.js" "${EXTRA_KEY_PREFIXES[*]}" $keys <<'PY'
import json, os, sys
root, out, prefixes, keys = sys.argv[1], sys.argv[2], sys.argv[3].split(), sys.argv[4:]
locales = json.load(open(os.path.join(root, "locales.json")))
catalog = {}
for code in sorted(locales):
  path = os.path.join(root, code, "shell.json")
  if not os.path.exists(path):
    continue
  strings = json.load(open(path))
  catalog[code] = {k: v for k, v in strings.items() if k in keys or any(k.startswith(p) for p in prefixes)}
registry = {code: {k: v for k, v in info.items() if k in ("direction", "decimal", "zeroDigit", "formatLocale")} for code, info in locales.items()}
with open(out, "w") as f:
  f.write("// Generated by bin/harvest-qt from Omarchy's default/i18n. Do not edit.\n.pragma library\n\n")
  f.write("var catalog = " + json.dumps(catalog, ensure_ascii=False, sort_keys=True) + "\n\n")
  f.write("var locales = " + json.dumps(registry, ensure_ascii=False, sort_keys=True) + "\n")
PY

git -C "$OMARCHY_SRC" rev-parse HEAD >"$REV_FILE"
echo "Harvested ${#UI_FILES[@]} components from $(git -C "$OMARCHY_SRC" log -1 --format='%h %s' HEAD)"
