#!/bin/bash

# The core's tests (the Rust resolver and its live switch, the C library and its live switch),
# then every binding's tests from the registry (tools/bindings.d/*.json: behavior tests and each
# binding's live-switch test, spec/following.md), token and icon parity with the core for every
# binding that resolves them itself, and the example apps (bin/test-examples). A binding whose
# toolchain is missing is skipped with a message. Renders are bin/review's job; this stays fast
# enough to run on every change.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fail=0

# The core: omarchy-theme (resolver, CLI, the live-switch test in tests/live_switch.rs) and the
# C library crate.
core_tests="$(cargo test -q --manifest-path "$ROOT/Cargo.toml" -p omarchy-theme -p omarchy-theme-ffi 2>&1)" || fail=1
grep -E "^test result|FAILED|panicked|^error" <<<"$core_tests" | sed 's/^/core: /' || true
"$ROOT/bin/build" >/dev/null

# The C library (build/ffi), built against through pkg-config as an app would, then a live switch
# under a HOME of its own.
if command -v cc >/dev/null && command -v pkg-config >/dev/null; then
  icons="$ROOT/fixtures/icons"
  mkdir -p "$ROOT/build/ffi-test"
  if cc -Wall -Wextra -Werror -o "$ROOT/build/ffi-test/live" "$ROOT/crates/omarchy-theme-ffi/tests/live.c" \
    $(PKG_CONFIG_PATH="$ROOT/build/ffi/lib/pkgconfig" pkg-config --cflags --libs omarchy-theme) -lpthread; then
    OMARCHY_UI_ICON_DIRS="$icons/local:$icons/system:$icons/pixmaps" OMARCHY_UI_ICON_THEME=Fixture-Accent \
      LD_LIBRARY_PATH="$ROOT/build/ffi/lib" "$ROOT/tools/live/run" "$ROOT/build/ffi-test/live" 2>&1 | sed 's/^c library: /core: c library: /' ||
      fail=1
  else
    echo "core: c library: the test didn't build against omarchy-theme.pc"
    fail=1
  fi
else
  echo "core: c library: skipped (no cc or pkg-config)"
fi

# Each binding's own tests, then parity with the core.
python3 "$ROOT/tools/bindings.py" test || fail=1
python3 "$ROOT/tools/bindings.py" parity || fail=1

# Each way of using the kit from an app (examples/), built and rendered once.
"$ROOT/bin/test-examples" || fail=1

exit "$fail"
